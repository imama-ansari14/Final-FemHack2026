# Copy this file to .env.local and fill in your own real values.
# NEVER commit .env.local to GitHub. It is already in .gitignore.

# MongoDB connection string (get this from MongoDB Atlas, see README)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/supportflow?retryWrites=true&w=majority

# Any long random string. You can generate one at https://generate-secret.vercel.app/32
JWT_SECRET=replace-this-with-a-long-random-string

# Google Gemini API key (get one free at https://aistudio.google.com/app/apikey)
# IMPORTANT: If you ever paste your key into a chat, an email, or a public repo,
# treat it as compromised and generate a brand new one immediately.
GEMINI_API_KEY=your-api-key

# App port
PORT=3000
